# ---- Database -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://risklens:risklens@localhost:5432/risklens

# ---- Data / models --------------------------------------------------
# Folder with the Kaggle Home Credit CSVs (also searched: ./data/raw, ./data/fresh)
RAW_DATA_DIR=./data
MODEL_PATH=./ml/artifacts
SAMPLE_PORTFOLIO=50000
SAMPLE_INTAKE=12000

# ---- Backend URL used by the Streamlit frontend ---------------------
API_URL=http://localhost:8000

# Optional: least-privilege DB role for the AI SQL tool (sql/ai_readonly_role.sql)
AI_DATABASE_URL=postgresql+psycopg://risklens_ai:risklens_ai@localhost:5432/risklens

# ---- AI Risk Analyst ------------------------------------------------
# anthropic | openai     (leave LLM_API_KEY empty to use the built-in
# deterministic planner — tools still run on live data, no LLM needed)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

ENVIRONMENT=development

# direct | mcp  — route the AI analyst's tool calls through the RiskLens MCP server
RISKLENS_TOOL_TRANSPORT=direct
